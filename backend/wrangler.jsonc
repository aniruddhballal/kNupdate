{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knupdate-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "ActivityRelay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ActivityRelay"] }]
}
