# Planned backend configuration. This file contains names only; never add real values.

APP_ENV=development
APP_PORT=8080
DATABASE_URL=postgresql://knupdate:change-me@localhost:5432/knupdate
DATABASE_SSL_MODE=disable

# OTP provider. The provider implementation will be selected during backend setup.
OTP_PROVIDER=development
OTP_API_KEY=
OTP_SENDER_ID=

# Firebase Cloud Messaging server credentials/configuration.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# Authentication and application secrets.
ACCESS_TOKEN_SECRET=replace-in-development
REFRESH_TOKEN_SECRET=replace-in-development
PHONE_HASH_SECRET=replace-in-development

# Product configuration. Keep global and server-controlled.
ACTIVITY_EXPIRY_HOURS=72
CONNECTION_CODE_EXPIRY_MINUTES=15
CONNECTION_REQUEST_EXPIRY_DAYS=30
